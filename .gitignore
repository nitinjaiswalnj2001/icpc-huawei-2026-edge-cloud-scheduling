venv/

# IDE / editor state
.vscode/
.idea/
*.code-workspace

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Stage-0/private archival material should remain outside the public repository
raw_exports/
raw_history/
*.zip

# Keep generated report PDF in Git; only ignore temporary LaTeX/build files
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/_build/
